# Local SQLite (default)
DATABASE_URL="file:./dev.db"

# Public URL (emails + referral links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Turso for production persistence on Vercel
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=""

# Optional: real welcome emails (otherwise mocked in outbox)
# RESEND_API_KEY=""
# EMAIL_FROM="Prelaunch Engine <onboarding@resend.dev>"

# Optional: force mock geo
# GEO_MOCK="1"

# Optional: salt for IP hashing
# IP_HASH_SALT="change-me"
